{
  "name": "inknote-ai-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node --env-file=.env server/index.mjs",
    "start": "node server/index.mjs",
    "dev:all": "concurrently -n server,vite -c blue,green \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
